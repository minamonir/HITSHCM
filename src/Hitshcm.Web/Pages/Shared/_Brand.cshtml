@using Hitshcm.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> L
<a asp-page="/Index" class="brand">
    <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
        <rect class="brand-mark-bg" width="32" height="32" rx="8" />
        <path class="brand-mark-fg" d="M10 8.5h2.4v6.1h7.2V8.5H22v15h-2.4v-6.7h-7.2V23.5H10v-15z" />
    </svg>
    <span class="brand-text">
        <span class="brand-name">@L["AppName"]</span>
        <span class="brand-tagline">@L["ProductTagline"]</span>
    </span>
</a>
