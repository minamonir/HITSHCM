@page
@model Hitshcm.Web.Pages.Account.ChangePasswordModel
@using Hitshcm.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> L
@{
    ViewData["Title"] = L["ChangePassword"];
    ViewData["Shell"] = "auth";
}

<section class="auth-split">
    <partial name="_AuthHero" />
    <div class="auth-panel">
        <div class="auth-card">
            <p class="kicker">@L["AppName"]</p>
            <h1 class="page-title">@L["ChangePassword"]</h1>
            <p class="lede">@(Model.Forced ? L["ChangePasswordForced"] : L["ChangePasswordOptional"])</p>

            <form method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="form-alert" role="alert"></div>

                <div class="field">
                    <label asp-for="Input.CurrentPassword">@L["CurrentPassword"]</label>
                    <input asp-for="Input.CurrentPassword" autocomplete="current-password" class="form-control" />
                    <span asp-validation-for="Input.CurrentPassword" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Input.NewPassword">@L["NewPassword"]</label>
                    <input asp-for="Input.NewPassword" autocomplete="new-password" class="form-control" />
                    <span asp-validation-for="Input.NewPassword" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Input.ConfirmPassword">@L["ConfirmPassword"]</label>
                    <input asp-for="Input.ConfirmPassword" autocomplete="new-password" class="form-control" />
                    <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
                </div>

                <button type="submit" class="btn btn-primary">@L["SubmitChangePassword"]</button>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
