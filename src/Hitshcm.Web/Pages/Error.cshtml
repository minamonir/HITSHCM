@page
@model ErrorModel
@using Hitshcm.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> L
@{
    ViewData["Title"] = L["ErrorTitle"];
}

<section class="error-card">
    <p class="kicker">@L["AppName"]</p>
    <h1 class="page-title">@L["ErrorTitle"]</h1>
    <p class="lede">@L["ErrorLead"]</p>

    @if (Model.ShowRequestId)
    {
        <p class="footnote">
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }
</section>
